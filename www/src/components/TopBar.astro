---
import BrandLink from "./BrandLink.astro";
import SidePanelBody from "./SidePanelBody.astro";

interface Props {
  slug?: string;
}

const { slug } = Astro.props;
---

<div class="topbar" data-open="false">
  <div class="topbar-brand">
    <BrandLink />
  </div>
  <button
    class="topbar-burger"
    type="button"
    aria-label="Open navigation menu"
    aria-expanded="false"
    aria-controls="topbar-menu"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>
</div>

<div id="topbar-menu" class="topbar-menu" hidden>
  <div class="topbar-menu-head">
    <span class="topbar-menu-title">Menu</span>
    <button
      class="topbar-close"
      type="button"
      aria-label="Close navigation menu"
    >
      &times;
    </button>
  </div>
  <div class="topbar-menu-body">
    <SidePanelBody activeSlug={slug} />
  </div>
</div>
<div class="topbar-backdrop" hidden></div>

<script>
  const bar = document.querySelector<HTMLElement>(".topbar");
  const menu = document.getElementById("topbar-menu");
  const backdrop = document.querySelector<HTMLElement>(".topbar-backdrop");
  const burger = document.querySelector<HTMLButtonElement>(".topbar-burger");
  const close = document.querySelector<HTMLButtonElement>(".topbar-close");

  function setOpen(open: boolean) {
    if (!bar || !menu || !backdrop || !burger) return;
    bar.dataset.open = String(open);
    burger.setAttribute("aria-expanded", String(open));
    if (open) {
      menu.classList.remove("is-closing");
      backdrop.classList.remove("is-closing");
      menu.hidden = false;
      backdrop.hidden = false;
      document.body.style.overflow = "hidden";
      close?.focus();
      return;
    }
    // let the fade-out play before hiding; skip it under reduced motion,
    // where the animation is disabled and animationend never fires
    const finish = () => {
      menu.classList.remove("is-closing");
      backdrop.classList.remove("is-closing");
      menu.hidden = true;
      backdrop.hidden = true;
      document.body.style.overflow = "";
      burger.focus();
    };
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      finish();
      return;
    }
    menu.addEventListener("animationend", finish, { once: true });
    menu.classList.add("is-closing");
    backdrop.classList.add("is-closing");
  }

  burger?.addEventListener("click", () =>
    setOpen(bar?.dataset.open !== "true")
  );
  close?.addEventListener("click", () => setOpen(false));
  backdrop?.addEventListener("click", () => setOpen(false));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && bar?.dataset.open === "true") setOpen(false);
  });
  menu
    ?.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
</script>

<style>
  .topbar {
    display: none;
    position: sticky;
    top: 0;
    z-index: 30;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.9rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .topbar-brand {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
  .topbar-burger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.28rem;
    width: 2.4rem;
    height: 2.4rem;
    margin-left: auto;
    padding: 0.55rem 0.5rem;
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .topbar-burger span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--fg);
    transition: width 0.15s ease;
  }
  /* middle bar rests tucked in; hover completes it, terminal-cursor style */
  .topbar-burger span:nth-child(2) {
    width: 65%;
    transition-delay: 0.03s;
  }
  .topbar-burger:hover span {
    width: 100%;
  }

  .topbar-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    overflow-y: auto;
    background: var(--bg);
    padding: 0.9rem;
  }
  .topbar-menu:not([hidden]) {
    animation: menu-in 0.18s ease;
  }
  .topbar-menu.is-closing {
    animation: menu-out 0.15s ease forwards;
  }
  .topbar-backdrop.is-closing {
    animation: fade-out 0.15s ease forwards;
  }
  @keyframes menu-out {
    from {
      opacity: 1;
      transform: none;
    }
    to {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }
  @keyframes fade-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .topbar-backdrop:not([hidden]) {
    animation: fade-in 0.18s ease;
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .topbar-menu-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }
  .topbar-menu-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--fg-dim);
  }
  .topbar-close {
    background: transparent;
    border: 0;
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 1.4rem;
    line-height: 1;
    width: 2.4rem;
    height: 2.4rem;
    cursor: pointer;
    transition: color 0.15s ease;
  }
  .topbar-close:hover {
    color: var(--fg);
  }
  .topbar-menu-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }
  .topbar-menu-body :global(.side-widget:last-child) {
    margin-top: 0;
  }
  .topbar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgb(0 0 0 / 60%);
  }

  @media (max-width: 51.25rem) {
    .topbar {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topbar-burger span,
    .topbar-menu:not([hidden]),
    .topbar-backdrop:not([hidden]) {
      animation: none;
      transition: none;
    }
  }
</style>

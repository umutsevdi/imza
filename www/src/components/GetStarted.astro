---
import { VERSION } from "../version";

// Download links resolve at build time from the tagged GitHub release; the
// release pipeline runs this build after attaching assets, passing
// IMZA_VERSION. Artifact names are discovered by extension, never hardcoded.
// Without IMZA_VERSION (local dev) fall back to the latest release.
interface Asset {
  url: string;
  file: string;
}

const RELEASES = "https://github.com/umutsevdi/imza/releases";
const pinned = VERSION !== "v0.0.0";
const endpoint = pinned
  ? `https://api.github.com/repos/umutsevdi/imza/releases/tags/${VERSION}`
  : "https://api.github.com/repos/umutsevdi/imza/releases/latest";

async function fetchAssets(): Promise<Record<string, Asset> | null> {
  try {
    const res = await fetch(endpoint, {
      headers: { Accept: "application/vnd.github+json" },
      signal: AbortSignal.timeout(5000)
    });
    if (!res.ok) return null;
    const data = await res.json();
    const found: Record<string, Asset> = {};
    for (const a of data.assets ?? []) {
      const m = a.name.match(/\.(deb|rpm|pkg|exe)$/);
      if (m && !found[m[1]])
        found[m[1]] = { url: a.browser_download_url, file: a.name };
    }
    return found;
  } catch {
    return null;
  }
}

const assets = await fetchAssets();
if (pinned) {
  const missing = ["pkg", "exe", "deb", "rpm"].filter((k) => !assets?.[k]);
  if (missing.length > 0) {
    throw new Error(
      `IMZA_VERSION=${VERSION} but release assets missing: ` +
        missing.join(", ")
    );
  }
}

interface Platform {
  key: string;
  name: string;
  ext: string;
  icon: "linux" | "apple" | "windows";
}

const platforms: Platform[] = [
  {
    key: "pkg",
    name: "macOS",
    ext: ".pkg",
    icon: "apple"
  },
  {
    key: "exe",
    name: "Windows",
    ext: ".exe",
    icon: "windows"
  },
  {
    key: "deb",
    name: "Debian / Ubuntu",
    ext: ".deb",
    icon: "linux"
  },
  {
    key: "rpm",
    name: "Fedora / RHEL",
    ext: ".rpm",
    icon: "linux"
  }
];

interface Resolved extends Platform {
  url: string;
  file: string;
}

const resolved: Resolved[] = platforms.map((p) => {
  const hit = assets?.[p.key];
  return {
    ...p,
    url: hit?.url ?? RELEASES,
    file: hit?.file ?? "latest " + p.ext + " on the releases page"
  };
});

const tagName = pinned ? VERSION : undefined;
---

<section class="get-started" id="get-started" aria-labelledby="get-started-h">
  <p class="section-label" id="get-started-h">
    Get started
    <span class="gs-tag"> · Download {tagName ?? ""} </span>
  </p>
  <div class="gs-grid">
    {
      resolved.map((p) => (
        <a class="btn gs-btn" href={p.url}>
          <span class="gs-btn-head">
            <svg
              class="gs-icon"

---
import { VERSION } from "../version";

// Download links resolve at build time from the tagged GitHub release; the
// release pipeline runs this build after attaching assets, passing
// IMZA_VERSION. Assets are keyed by OS *and* architecture: two packages can
// share an extension (linux-x64.deb and linux-arm64.deb), so an
// extension-keyed map would silently drop one of them.
interface Asset {
  url: string;
  file: string;
  os: string;
  arch: string;
  ext: string;
}

const RELEASES = "https://github.com/umutsevdi/imza/releases";
const BREW_COMMAND = "brew install umutsevdi/imza/imza";
const pinned = VERSION !== "v0.0.0";
const endpoint = pinned
  ? `https://api.github.com/repos/umutsevdi/imza/releases/tags/${VERSION}`
  : "https://api.github.com/repos/umutsevdi/imza/releases/latest";

async function fetchAssets(): Promise<Asset[]> {
  try {
    const res = await fetch(endpoint, {
      headers: { Accept: "application/vnd.github+json" },
      signal: AbortSignal.timeout(5000)
    });
    if (!res.ok) return [];
    const data = await res.json();
    const found: Asset[] = [];
    for (const a of data.assets ?? []) {
      const m = a.name.match(
        /^imza-(.+)-(linux|macos|windows)-(x64|arm64)\.(deb|rpm|pkg|exe)$/
      );
      if (!m) continue;
      found.push({
        url: a.browser_download_url,
        file: a.name,
        os: m[2],
        arch: m[3],
        ext: m[4]
      });
    }
    return found;
  } catch {
    return [];
  }
}

const assets = await fetchAssets();

// Every artifact the release pipeline is expected to publish. A pinned build
// fails loudly when one is missing, so a release that forgot an architecture
// breaks the site build instead of shipping a link to the wrong package.
const EXPECTED: ReadonlyArray<[string, string, string]> = [
  ["macos", "arm64", "pkg"],
  ["windows", "x64", "exe"],
  ["linux", "x64", "deb"],
  ["linux", "arm64", "deb"],
  ["linux", "x64", "rpm"],
  ["linux", "arm64", "rpm"]
];

if (pinned) {
  const missing = EXPECTED.filter(
    ([os, arch, ext]) =>
      !assets.some((a) => a.os === os && a.arch === arch && a.ext === ext)
  ).map(([os, arch, ext]) => `${os}-${arch}.${ext}`);
  if (missing.length > 0) {
    throw new Error(
      `IMZA_VERSION=${VERSION} but release assets missing: ` +
        missing.join(", ")
    );
  }
}

type Icon = "linux" | "apple" | "windows";

interface Platform {
  key: string;
  name: string;
  icon: Icon;
  // Architecture order within the group: the one most users want comes first.
  archOrder: string[];
}

const platforms: Platform[] = [
  {
    key: "macos",
    name: "macOS",
    icon: "apple",
    archOrder: ["arm64", "x64"]
  },
  {
    key: "windows",
    name: "Windows",
    icon: "windows",
    archOrder: ["x64", "arm64"]
  },
  {
    key: "linux",
    name: "Linux",
    icon: "linux",
    archOrder: ["x64", "arm64"]
  }
];

const archLabel = (os: string, arch: string) => {
  if (os === "macos") return arch === "arm64" ? "Apple Silicon" : "Intel";
  return arch === "arm64" ? "arm64" : "x64";
};

interface Row {
  os: string;
  arch: string;
  label: string;
  formats: Asset[];
}

// One row per OS/architecture pair; the row carries every package format for
// that pair, so Linux shows x64 and arm64 rather than four flat entries.
const groups = platforms
  .map((p) => {
    const rows: Row[] = [];
    for (const arch of p.archOrder) {
      const formats = assets.filter((a) => a.os === p.key && a.arch === arch);
      if (formats.length === 0) continue;
      formats.sort((a, b) => a.ext.localeCompare(b.ext));
      rows.push({ os: p.key, arch, label: archLabel(p.key, arch), formats });
    }
    return { ...p, rows };
  })
  .filter((g) => g.rows.length > 0);

// The primary control's fallback target: the releases page when the API is
// unreachable, otherwise the first asset so a no-JS visitor still downloads
// something installable.
const fallbackUrl = groups[0]?.rows[0]?.formats[0]?.url ?? RELEASES;
const tagName = pinned ? VERSION : undefined;
---

<section class="get-started" id="get-started" aria-labelledby="get-started-h">
  <p class="section-label" id="get-started-h">
    Get started
    <span class="gs-tag"> · Download {tagName ?? ""} </span>
  </p>

  <div class="brew-panel tui-panel" hidden data-brew-panel>
    <p class="brew-head">Install with Homebrew</p>
    <pre
      class="code-block brew-cmd"><span class="t-prompt">$</span> {BREW_COMMAND}</pre>
    <div class="brew-foot">
      <button class="brew-copy" type="button" data-copy={BREW_COMMAND}>
        copy
      </button>
      <span class="brew-note">Recommended on macOS · updates with brew</span>
    </div>
  </div>

  <div class="dl">
    <a class="btn dl-primary" href={fallbackUrl} data-dl-primary>
      <svg
        class="dl-icon"
        viewBox="0 0 16 16"
        fill="currentColor"
        aria-hidden="true"
      >
        <path
          d="M7.25 1.5a.75.75 0 0 1 1.5 0v7.19l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V1.5Z"
        ></path>
        <path
          d="M2.75 11a.75.75 0 0 1 .75.75v1.5h9v-1.5a.75.75 0 0 1 1.5 0v1.75c0 .69-.56 1.25-1.25 1.25H3c-.69 0-1.25-.56-1.25-1.25v-1.75a.75.75 0 0 1 .75-.75Z"
        ></path>
      </svg>
      <span class="dl-label" data-dl-label>Download</span>
    </a>
    <details class="dl-menu" data-dl-menu>
      <summary class="dl-toggle" aria-label="All download options">
        <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path
            d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z"
          ></path>
        </svg>
      </summary>
      <div class="dl-list">
        {
          groups.map((g) => (
            <div class="dl-group">
              <p class="dl-os">{g.name}</p>
              {g.rows.map((row) => (
                <div class="dl-row">
                  <span class="dl-arch">{row.label}</span>
                  <span class="dl-formats">
                    {row.formats.map((f) => (
                      <a
                        class="dl-fmt"
                        href={f.url}
                        data-asset
                        data-os={f.os}
                        data-arch={f.arch}
                        data-ext={f.ext}
                        data-url={f.url}
                        data-file={f.file}
                        title={f.file}
                      >
                        .{f.ext}
                      </a>
                    ))}
                  </span>
                </div>
              ))}
            </div>
          ))
        }
        {
          groups.length === 0 && (
            <p class="dl-empty">
              Downloads are on the <a href={RELEASES}>releases page</a>.
            </p>
          )
        }
      </div>
    </details>
  </div>

  <p class="gs-next">
    New here? Check out the <a href="/docs/">wiki</a>. Prefer to build from
    source? Check out the <a href="/docs/installation/#building-from-source"
      >build instructions</a
    >.
  </p>
</section>

<script>
  // Platform detection only rewrites the primary link and reveals the
  // Homebrew panel; the markup above is already usable without this script.
  interface AssetLink extends HTMLAnchorElement {
    dataset: DOMStringMap & {
      os: string;
      arch: string;
      ext: string;
      url: string;
      file: string;
    };
  }

  const primary =
    document.querySelector<HTMLAnchorElement>("[data-dl-primary]");
  const label = document.querySelector<HTMLElement>("[data-dl-label]");
  const brewPanel = document.querySelector<HTMLElement>("[data-brew-panel]");

  function detect(): { os: string; arch: string } | null {
    const ua = navigator.userAgent;
    const platform =
      (navigator as any).userAgentData?.platform ?? navigator.platform ?? "";
    const arm = /arm64|aarch64/i.test(ua) || /arm/i.test(platform);

    if (/mac/i.test(platform) || /Mac OS X/i.test(ua)) {
      // Mac user agents name Intel even on Apple silicon, so the
      // architecture is unprovable in a user agent; default to arm64 and
      // let the UA-CH refinement below correct genuine Intel Macs.
      return { os: "macos", arch: "arm64" };
    }
    if (/win/i.test(platform) || /Windows/i.test(ua)) {
      return { os: "windows", arch: arm ? "arm64" : "x64" };
    }
    if (/linux/i.test(platform) || /Linux/i.test(ua)) {
      return { os: "linux", arch: arm ? "arm64" : "x64" };
    }
    return null;
  }

  const archName: Record<string, string> = {
    arm64: "arm64",
    x64: "x64"
  };

  const links = Array.from(
    document.querySelectorAll<AssetLink>("[data-asset]")
  );

  // Resolve the best asset for a platform guess and rewrite the primary
  // button. Runs synchronously from the UA sniff, then once more
  // (Chromium only) with the high-entropy architecture answer, the only
  // source that tells Apple silicon and Intel Macs apart.
  function apply(os: string, arch: string) {
    // Firefox names the distribution in its user agent, so rpm-family
    // distros (Fedora, RHEL/SUSE lineage) get rpm; Chromium builds carry
    // no distro marker and default to deb, Ubuntu-family being the
    // largest audience. The label names the format either way, so a
    // misclick is never a surprise.
    const wantsRpm =
      /fedora|red ?hat|rhel|centos|rocky|almalinux|suse|opensuse|sles|oracle|clear-?linux/i.test(
        `${navigator.userAgent} ${(navigator as any).oscpu ?? ""}`
      );
    const preferred =
      os === "macos"
        ? "pkg"
        : os === "windows"
          ? "exe"
          : wantsRpm
            ? "rpm"
            : "deb";
    const match =
      links.find(
        (a) =>
          a.dataset.os === os &&
          a.dataset.arch === arch &&
          a.dataset.ext === preferred
      ) ?? links.find((a) => a.dataset.os === os && a.dataset.arch === arch);

    if (!match || !primary || !label) return;
    primary.href = match.dataset.url;
    const archLabel =
      os === "macos"
        ? arch === "arm64"
          ? "Apple Silicon"
          : "Intel"
        : (archName[arch] ?? arch);
    label.textContent = `Download (${archLabel} ${match.dataset.ext})`;
  }

  const detected = detect();
  if (detected) {
    if (detected.os === "macos" && brewPanel) brewPanel.hidden = false;
    apply(detected.os, detected.arch);

    // Chromium exposes the true CPU architecture only through high-entropy
    // UA-CH hints; every other browser keeps the user-agent guess above.
    const uad = (navigator as any).userAgentData as
      | {
          getHighEntropyValues?: (
            hints: string[]
          ) => Promise<{ architecture?: string }>;
        }
      | undefined;
    uad?.getHighEntropyValues?.(["architecture"])?.then?.((hint) => {
      const arm = hint.architecture?.includes("arm");
      const x86 = hint.architecture?.includes("x86");
      if (arm || x86) apply(detected.os, arm ? "arm64" : "x64");
    });
  }

  // <details> has no outside-click or Escape dismissal of its own.
  const menu = document.querySelector<HTMLDetailsElement>("[data-dl-menu]");
  if (menu) {
    document.addEventListener("click", (e) => {
      if (menu.open && !menu.contains(e.target as Node)) menu.open = false;
    });
    menu.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
    // Choosing a file closes the menu; the link still navigates.
    menu.querySelectorAll("a").forEach((a) =>
      a.addEventListener("click", () => {
        menu.open = false;
      })
    );
  }

  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const text = btn.dataset.copy ?? "";
      const original = btn.textContent;
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = "copied";
      } catch {
        btn.textContent = "select & copy";
      }
      setTimeout(() => {
        btn.textContent = original;
      }, 1600);
    });
  });
</script>

<style>
  .gs-tag {
    margin: -0.8rem 0 1.2rem;
    color: var(--fg-dim);
    font-size: 0.95rem;
  }

  /* ---- Homebrew panel ---- */
  .brew-panel {
    max-width: 34rem;
    margin: 0 auto 1.1rem;
  }
  .brew-head {
    margin: 0;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--fg-dim);
    border-bottom: 1px solid var(--border);
  }
  .brew-cmd {
    padding: 0.7rem 1.1rem;
    font-size: clamp(0.75rem, 0.7rem + 0.25vw, 0.9rem);
    line-height: 1.5;
  }
  .brew-foot {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.5rem 1.1rem;
    border-top: 1px solid var(--border);
    background: var(--focus);
  }
  .brew-copy {
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--fg);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 0.1875rem;
    padding: 0.15rem 0.6rem;
    cursor: pointer;
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }
  .brew-copy:hover {
    background: var(--hl-cyan);
    border-color: var(--hl-cyan);
    color: #0b0e12;
  }
  .brew-note {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }
  .t-prompt {
    color: var(--hl-green);
  }

  /* ---- split download control ---- */
  .dl {
    position: relative;
    display: flex;
    max-width: 34rem;
    margin: 0 auto 1.4rem;
  }
  .dl-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    flex: 1 1 auto;
    min-width: 0;
    background: var(--hl-blue);
    color: #0b0e12;
    border: 1px solid var(--hl-blue);
    padding: 0.55rem 1rem;
  }
  .dl-primary:hover {
    background: var(--hl-cyan);
    border-color: var(--hl-cyan);
    color: #0b0e12;
    text-decoration: none;
  }
  .dl-icon {
    width: 1rem;
    height: 1rem;
    flex: 0 0 auto;
  }
  .dl-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .dl-menu {
    flex: 0 0 auto;
  }
  .dl-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 100%;
    cursor: pointer;
    list-style: none;
    background: var(--hl-blue);
    color: #0b0e12;
    border: 1px solid var(--hl-blue);
    border-left: 1px solid rgb(0 0 0 / 35%);
  }
  .dl-toggle::-webkit-details-marker {
    display: none;
  }
  .dl-toggle svg {
    width: 1rem;
    height: 1rem;
    transition: transform 0.15s ease;
  }
  .dl-menu[open] .dl-toggle svg {
    transform: rotate(180deg);
  }
  .dl-toggle:hover {
    background: var(--hl-cyan);
    border-color: var(--hl-cyan);
  }

  /* Opens upward: the section sits at the document bottom, so a downward
     popup would extend the page and slide under the sticky statusbar. The
     containing block is the .dl row, whose height is stable regardless of
     the <details> open-state geometry. */
  .dl-list {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.35rem);
    z-index: 21;
    min-width: 19rem;
    padding: 0.5rem;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    box-shadow: 0 0.6rem 1.6rem rgb(0 0 0 / 45%);
  }
  .dl-group + .dl-group {
    margin-top: 0.45rem;
    padding-top: 0.45rem;
    border-top: 1px solid var(--border);
  }
  .dl-os {
    margin: 0 0 0.2rem;
    padding: 0 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--fg-dim);
  }
  .dl-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.1875rem;
  }
  .dl-row:hover {
    background: var(--focus);
  }
  .dl-arch {
    font-size: 0.88rem;
    color: var(--fg);
  }
  .dl-formats {
    display: flex;
    gap: 0.35rem;
  }
  .dl-fmt {
    font-size: 0.82rem;
    color: var(--hl-blue);
    padding: 0.05rem 0.3rem;
    border-radius: 0.1875rem;
  }
  .dl-fmt:hover {
    background: var(--hl-cyan);
    color: #0b0e12;
    text-decoration: none;
  }
  .dl-empty {
    margin: 0;
    padding: 0.3rem 0.4rem;
    font-size: 0.88rem;
    color: var(--fg-dim);
  }

  .gs-next {
    margin: 0;
    color: var(--fg-dim);
    font-size: 0.95rem;
    text-align: center;
  }

  @media (max-width: 47.5rem) {
    .dl-list {
      right: auto;
      left: 0;
      min-width: min(19rem, calc(100vw - 3rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dl-toggle svg,
    .brew-copy {
      transition: none;
    }
  }
</style>

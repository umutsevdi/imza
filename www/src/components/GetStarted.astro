      ))
    }
  </div>
  <p class="gs-next">
    New here? Check out the <a href="/docs/">wiki</a>. Prefer to build from
    source? Check out the <a href="/docs/installation/#building-from-source"
      >build instructions</a
    >.
  </p>
</section>
<style>
  .gs-tag {
    margin: -0.8rem 0 1.2rem;
    color: var(--fg-dim);
    font-size: 0.95rem;
  }
  .gs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.4rem;
  }
  .gs-btn {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.7rem 1rem;
    text-align: left;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  .gs-btn:hover {
    background: var(--hl-cyan);
    color: #0b0e12;
    text-decoration: none;
  }
  .gs-btn-head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .gs-icon {
    width: 1.2rem;
    height: 1.2rem;
    flex: 0 0 auto;
  }
  .gs-name {
    font-size: 1rem;
  }
  .gs-file {
    font-size: 0.8rem;
    font-weight: 400;
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .gs-btn:hover .gs-file {
    color: #0b0e12;
  }
  .gs-next {
    margin: 0;
    color: var(--fg-dim);
    font-size: 0.95rem;
  }
  @media (max-width: 47.5rem) {
    .gs-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
const banner = `             AAAAA6
           AAAAAAAAAW
          AAAAAAAAAAA
          AAAAAAAAAAAw
          AAAAAAAAAAA
            AAAAAAAn
                             AAAAA AAAAA
           AAAA             AAA       AAA
         AAAAAAAA           AAA       AAA
        eAAAAAAAA           AAA       AAA
        AAAAAAAA            AAA       AAA
       AAAAAAAAA          AAAA         AAAE
      jAAAAAAAA          AAAA          wAAAA
      AAAAAAAAr             AAj       AAA
     AAAAAAAAA              AAA       AAA
    NAAAAAAAA               AAA       AAA
    AAAAAAAA                AAA       AAA
   AAAAAAAAA            NAA rAAAAr jAAAA
  AAAAAAAAA         AAAAAAAAAn AAA AAN
  AAAAAAAA        AAAAAAAAAAAA        w
 AAAAAAAAA     AAAAAAAA wAAAAA  0AAAAAAAAAAA
1AAAAAAAA    AAAAAAAw    AAAAAAAAAAAAAAAAAAAAE

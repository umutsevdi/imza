---

<section class="hero" id="top">
  <div class="banner-wrap" aria-hidden="true">
    <pre class="banner">{banner}</pre>
  </div>
  <div class="banner-group">
    <h1 class="hero-name">imza</h1>
    <p class="hero-support">
      A terminal coding agent that doesn't hide what it does. Plan it together,
      build it together, review it together. imza efficiently speeds up
      development without leaving you behind.
    </p>
    <p class="hero-support">Don't lose control over your codebase</p>
  </div>
  <div class="hero-actions">
    <a class="btn btn-ghost" href="https://github.com/umutsevdi/imza">
      Source Code
    </a>
    <a class="btn btn-primary" href="#get-started"> Download </a>
    <a class="btn btn-ghost" href="/docs/"> Wiki </a>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }
  .banner-wrap {
    display: flex;
    justify-content: center;
    margin: 0 0 1.8rem;
  }
  .banner {
    margin: 0;
    font-family: var(--mono);
    font-size: clamp(0.3rem, 0.45vw + 0.18rem, 0.55rem);
    line-height: 1.05;
    color: var(--fg-dim);
    text-align: left;
    white-space: pre;
    overflow-x: auto;
    max-width: 100%;
  }
  .banner-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin: 0 0 1.8rem;
  }
  .hero-name {
    font-family: var(--mono);
    font-weight: 700;
    font-size: clamp(2.6rem, 1.6rem + 4.6vw, 4.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    margin: 0 0 1rem;
    color: var(--fg);
  }
  .hero-name::after {
    content: "_";
    color: var(--fg);
    animation: blink 1.1s steps(1) infinite;
  }
  .hero-support {
    max-width: var(--measure);
    color: var(--fg-dim);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem);
    margin: 0 0 1.6rem;
  }
  .hero-support + .hero-support {
    margin-top: -0.8rem;
    color: var(--fg);
    font-weight: 700;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .hero-actions {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 0 auto 0.5rem;
    max-width: 28rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-name::after {
      animation: none;
    }
  }

  @media (max-width: 51.25rem) {
    .banner {
      font-size: clamp(0.7rem, 0.45vw + 0.18rem, 0.55rem);
    }

    .hero-actions {
      gap: 0.2rem;
    }
  }
</style>

---
import { VERSION } from "../version";
import { withBase } from "../lib/docs";

// status bar mimics the app's cwd prompt: ~/, ~/docs/, ~/changelog/ ...
// pathname carries the base (e.g. /imza) — display paths site-root-relative
const baseRx = new RegExp("^" + import.meta.env.BASE_URL.replace(/\/$/, ""));
const dir = "~" + Astro.url.pathname.replace(baseRx, "");
---

<footer class="statusbar-bar" role="contentinfo">
  <span class="sb-left">
    <span class="sb-mode" id="sb-mode"> PLAN </span>
    <span class="sb-sep">·</span>

    <a href="https://github.com/umutsevdi/imza">repository</a>
    <span class="sb-sep">·</span>
    <a href={withBase("/docs/")}>wiki</a>
    <span class="sb-sep">·</span>
    <a href="https://github.com/umutsevdi/imza/releases">releases</a>
  </span>
  <span class="sb-gap"></span>
  <span class="sb-right">
    <span class="sb-dir">{dir}</span>
    <span class="sb-ver">IMZA {VERSION}</span>
  </span>
</footer>

<script>
  const widgets = Array.from(
    document.querySelectorAll<HTMLElement>(".nav-link[data-label]")
  );
  const sbMode = document.getElementById("sb-mode");
  const byHash = new Map<string, HTMLElement>();
  for (const w of widgets) byHash.set(w.getAttribute("href") ?? "", w);

  if ("IntersectionObserver" in window) {
    const sections = Array.from(
      document.querySelectorAll<HTMLElement>("main section[id]")
    );
    const visible = new Map<string, number>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const en of entries) {
          visible.set(
            en.target.id,
            en.isIntersecting ? en.intersectionRatio : 0
          );
        }
        let best: HTMLElement | null = null;
        let bestR = 0;
        for (const s of sections) {
          const r = visible.get(s.id) ?? 0;
          if (r > bestR) {
            bestR = r;
            best = s;
          }
        }
        if (!best) return;
        for (const w of widgets) w.classList.remove("is-active");
        const w = byHash.get("#" + best.id);
        if (!w) return;
        w.classList.add("is-active");
        if (sbMode) {
          const label = (w.dataset.label ?? "imza").toUpperCase();
          sbMode.textContent = ` ${label} `;
          // imza phase colors: PLAN=green, BUILD=red, REVIEW=cyan
          let phaseColor = "#68D8E8";
          if (best.id === "top" || best.id === "loop") phaseColor = "#7EE787";
          else if (["why"].includes(best.id)) phaseColor = "#F77272";
          sbMode.style.background = phaseColor;
          sbMode.style.color = "#2D3238";
        }
      },
      { rootMargin: "-45% 0px -45% 0px", threshold: [0, 0.25, 0.5, 1] }
    );
    for (const s of sections) io.observe(s);
  }
</script>

<style>
  .statusbar-bar {
    position: sticky;
    bottom: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    background: var(--focus);
    color: var(--fg);
    font-size: 0.95rem;
    font-weight: 500;
    border-top: 0;
  }
  .statusbar-bar a {
    color: var(--fg);
    text-decoration: none;
  }
  .statusbar-bar a:hover {
    color: var(--hl-cyan);
    text-decoration: underline;
  }
  .sb-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 0 auto;
  }
  .sb-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
  }
  /* mode token: inverted like imza — colored bg + dark panel text, flush left.
     Boots PLAN green like the app (status_line.cpp); scroll-spy recolors it. */
  .sb-mode {
    font-weight: bold;
    background: var(--hl-green);
    color: var(--focus);
    padding: 0.05rem 0.5rem 0.05rem 0.6rem;
  }
  .sb-sep {
    color: var(--fg-dim);
    flex: 0 0 auto;
  }
  .sb-gap {
    flex: 1 1 auto;
    min-width: 1rem;
  }
  .sb-dir {
    color: var(--fg-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 28vw;
    flex: 0 0 auto;
  }
  .sb-ver {
    background: var(--fg);
    color: var(--bg);
    padding: 0.05rem 0.6rem 0.05rem 0.5rem;
    font-weight: 700;
    flex: 0 0 auto;
  }
  @media (max-width: 40rem) {
    .sb-dir {
      display: none;
    }
  }
</style>

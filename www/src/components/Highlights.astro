---
import SystemFlow from "./SystemFlow.astro";

const cards = [
  {
    wide: true,
    viz: true,
    title: "The Sandbox",
    body: "Most agents give the model a bunch of single-purpose tools; every call costs an extra round-trip and more context. imza gives it a single sandboxed Lua environment instead, where it can run many of those steps at once and only the result comes back. Every action still passes the permission gate, so you see each file touched and every command run.",
    link: {
      href: "https://github.com/umutsevdi/imza/discussions/1",
      text: "Read the analysis"
    }
  },
  {
    title: "Fast and Small",
    body: "A ~20 MB native binary, 5–8 MB RAM at startup, 20-40MB during regular tasks. No JavaScript runtime, no Electron, instant startup time."
  },
  {
    title: "Batteries Included",
    body: "MCP, subagents, skills, project instruction files, multimodal inputs, terminal notifications, and more."
  },
  {
    title: "Bring the Model You Already Pay For",
    body: "Imza supports 50+ providers out of the box. Bring any OpenAI-compatible or Anthropic endpoint: local, API, or subscription."
  },
  {
    title: "Permissions that Respect the Workspace",
    body: "Most harnesses push you toward full-access modes or ask about every single command. imza watches what the model is doing and asks only when an action can actually mutate the workspace."
  },
  {
    title: "Configuration Without Obscurity",
    body: "Every setting has an interface: /model, /variant, /subagents, and more. No environment magic, no hand-rolled config files. When you do want the file, it's plain JSON."
  },
  {
    title: "The Prompts Are Yours",
    body: "Every built-in prompt fragment(system, subagents, compaction, AI review) can be replaced with your own Markdown. "
  }
];
---

<section class="why" id="highlights" aria-labelledby="highlights-h">
  <p class="section-label" id="highlights-h">Highlights</p>
  <div class="why-grid">
    {
      cards.map((c) => (
        <article class="why-card" class:list={{ "is-wide": c.wide }}>
          <h3 class="why-title">{c.title}</h3>
          <p class="why-body">{c.body}</p>
          {c.link && (
            <a class="why-link" href={c.link.href}>
              {c.link.text} <span aria-hidden="true">&gt;</span>
            </a>
          )}
          {c.viz && (
            <div class="why-viz">
              <SystemFlow title={null} brief={null} />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--bg);
    overflow: hidden;
  }
  .why-card {
    padding: 1.4rem 1.5rem;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    margin: -1px 0 0 -1px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .why-card:hover {
    background: var(--focus);
  }
  /* the wide card hosts the diagram; a hover wash would clash with its
     panels, so it keeps its own background */
  .why-card.is-wide:hover {
    background: transparent;
  }
  .why-card.is-wide {
    grid-column: 1 / -1;
  }
  .why-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--fg);
  }
  .why-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .why-link {
    font-size: 0.88rem;
    align-self: start;
  }
  /* the embedded diagram bleeds to the card edges and drops the panel
     chrome, since the card already provides the border */
  .why-viz {
    margin: 0.6rem -1.5rem -1.4rem;
  }
  .why-viz :global(.tui-panel) {
    border: 0;
    border-radius: 0;
    border-top: 1px solid var(--border);
    background: transparent;
  }
  @media (max-width: 47.5rem) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

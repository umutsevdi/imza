---
import SystemFlow from "./viz/SystemFlow.astro";

const cards = [
  {
    wide: true,
    viz: true,
    key: "lua orchestration",
    title: "One sandbox instead of a tool bag",
    body: "Most coding agents hand the model a separate tool for every job, so each read, edit, or command is its own round-trip and its full output stays in the conversation. imza gives the model a single sandboxed Lua environment, where it can run many of those steps at once and only the result comes back. Nothing runs without passing a permission check, so you can still see every file touched and every command run. Fewer round-trips and less tool output mean the agent spends fewer tokens and finishes sooner.",
    link: {
      href: "https://github.com/umutsevdi/imza/discussions/1",
      text: "Read the analysis"
    }
  },
  {
    key: "performance",
    title: "Fast and small, yet it does it all",
    body: "A ~20 MB C++ binary that idles at 5-8 MB of RAM. No JavaScript runtime, no Electron. Starts instantly, runs smoothly."
  },
  {
    key: "subagents, skills & more",
    title: "Batteries included",
    body: "MCP, subagents, skills, project instruction files (AGENTS.md, CLAUDE.md, GEMINI.md), multimodal inputs, terminal notifications, and more."
  },
  {
    key: "50+ providers",
    title: "Bring the model you already pay for",
    body: "Any OpenAI-compatible endpoint or the Anthropic API: hosted, subscription-backed, or running on your own machine. Connect the same provider twice under different labels and easily switch between accounts."
  },
  {
    key: "sane permissions",
    title: "Permissions that respect the workspace",
    body: "Most harnesses either push you toward dangerous full-access modes or ask about every single command. imza monitors the model's behaviour and only asks when an action can mutate the workspace. Runtime flags can remove entire tool families before the session even starts."
  },
  {
    key: "configuration without obscurity",
    title: "Configure everything from the TUI",
    body: "Every setting has an interface: swap models with /model, reasoning effort with /variant, give each subagent role its own model with /subagents. No environment magic, no hand-rolled config files; and when you do want the file, it's plain JSON."
  },
  {
    key: "context engineering",
    title: "The prompts are yours",
    body: "Every built-in prompt fragment (system, subagents, compaction, AI review, plan revision) can be overridden with your own Markdown in a prompts/ directory. Defaults ship in the repo, so you diff against them instead of guessing."
  }
];
---

<section class="why" id="why" aria-labelledby="why-h">
  <p class="section-label" id="why-h">Why imza</p>
  <div class="why-grid">
    {
      cards.map((c) => (
        <article class="why-card" class:list={{ "is-wide": c.wide }}>
          <p class="why-key">{c.key}</p>
          <h3 class="why-title">{c.title}</h3>
          <p class="why-body">{c.body}</p>
          {c.link && (
            <a class="why-link" href={c.link.href}>
              {c.link.text} <span aria-hidden="true">&gt;</span>
            </a>
          )}
          {c.viz && (
            <div class="why-viz">
              <SystemFlow title={null} brief={null} />
            </div>
          )}
        </article>
      ))
    }
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    background: var(--bg);
    overflow: hidden;
  }
  .why-card {
    padding: 1.4rem 1.5rem;
    border-top: 1px solid var(--border);
    border-left: 1px solid var(--border);
    margin: -1px 0 0 -1px;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .why-card:hover {
    background: var(--focus);
  }
  /* the wide card hosts the diagram; a hover wash would clash with its
     panels, so it keeps its own background */
  .why-card.is-wide:hover {
    background: transparent;
  }
  .why-card.is-wide {
    grid-column: 1 / -1;
  }
  .why-key {
    margin: 0;
    font-family: var(--mono);
    font-size: 0.8rem;
    color: var(--hl-yellow);
  }
  .why-title {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--fg);
  }
  .why-body {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--fg-dim);
  }
  .why-link {
    font-size: 0.88rem;
    align-self: start;
  }
  /* the embedded diagram bleeds to the card edges and drops the panel
     chrome, since the card already provides the border */
  .why-viz {
    margin: 0.6rem -1.5rem -1.4rem;
  }
  .why-viz :global(.tui-panel) {
    border: 0;
    border-radius: 0;
    border-top: 1px solid var(--border);
    background: transparent;
  }
  @media (max-width: 47.5rem) {
    .why-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

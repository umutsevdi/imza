---
const items = [
  {
    key: "bring your own model",
    desc: "OpenAI-compatible endpoints and the Anthropic Messages API, including local servers like <code>http://localhost:1234/v1</code>. Key, subscription, or none."
  },
  {
    key: "subagents",
    desc: "up to five run concurrently; each role gets its own model and reasoning effort via <code>/subagents</code>."
  },
  {
    key: "skills",
    desc: "mention <code>$name</code> to load a reusable instruction bundle; project instruction files (AGENTS.md, CLAUDE.md, GEMINI.md…) are discovered automatically."
  }
];
---

<section class="models" id="models" aria-labelledby="models-h">
  <p class="section-label" id="models-h">Models &amp; Execution</p>
  <p class="block-intro">
    Bring your own model, delegate the mechanical work, and shape behavior with
    skills you control.
  </p>
  <div class="tui-panel">
    <p class="help-cmd">
      <span class="prompt-path">~/project</span>
      <span class="prompt-glyph">$</span> imza --connect
    </p>
    <ul class="help-list">
      {
        items.map((it) => (
          <li class="help-item">
            <span class="hl-yellow">{it.key}</span>
            <span class="help-desc set:html={it.desc}" />
          </li>
        ))
      }
    </ul>
  </div>
</section>

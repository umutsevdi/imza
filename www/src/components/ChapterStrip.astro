---
import { docPages, hrefFor } from "../lib/docs";

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
const pages = docPages();
---

<nav class="chapter-strip" aria-label="Documentation pages">
  <span class="strip-label">Guide</span>
  <div class="strip-track">
    {
      pages.map((p) => (
        <a
          class="strip-pill"
          class:list={{ "is-active": p.slug === activeSlug }}
          href={hrefFor(p.slug)}
          aria-current={p.slug === activeSlug ? "page" : undefined}
        >
          {p.file.match(/^(\d+)/)?.[1] ?? "##"} {p.title}
        </a>
      ))
    }
  </div>
</nav>

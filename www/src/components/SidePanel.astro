---
import BrandLink from "./BrandLink.astro";
import SidePanelBody from "./SidePanelBody.astro";

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<aside class="sidepanel" aria-label="Page navigation">
  <div class="side-brand">
    <BrandLink />
  </div>

  <SidePanelBody activeSlug={activeSlug} />
</aside>

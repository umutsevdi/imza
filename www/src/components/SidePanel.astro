---
import icon from "../../../misc/icon.png";
import SidePanelBody from "./SidePanelBody.astro";

interface Props {
  activeSlug?: string;
}

const { activeSlug } = Astro.props;
---

<aside class="sidepanel" aria-label="Page navigation">
  <div class="side-brand">
    <a class="side-brand-link" href="/">
      <img
        class="sidepanel-icon"
        src={icon.src}
        alt=""
        width="22"
        height="22"
      />
      <span class="side-name">imza</span>
    </a>
  </div>

  <SidePanelBody activeSlug={activeSlug} />
</aside>

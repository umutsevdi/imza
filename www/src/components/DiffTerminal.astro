<section class="diff-section" id="diff" aria-labelledby="diff-h">
  <p class="section-label" id="diff-h">Live Diffs</p>
  <div
    class="tui-panel terminal"
    role="img"
    aria-label="A terminal showing imza producing a diff, with a note inviting you to sign off on the change."
  >
    <div class="tui-bar">
      <span class="tui-dot"></span><span class="tui-dot"></span><span
        class="tui-dot"></span>
      <span class="tui-title">imza session</span>
    </div>
    <pre
      class="term-body"><span class="t-prompt">imza</span> <span class="t-arg">refactor the parser to stream tokens</span>

<span class="t-muted">plan → build | showing diffs live</span>

<span class="t-file">src/parser.cpp</span>
<span class="t-ctx">   Token next() {"{"}</span>
<span class="t-del">-     return buffer_[pos_++];</span>
<span class="t-add">+     while (!eof() &amp;&amp; !is_boundary(peek()))</span>
<span class="t-add">+       emit(peek()), advance();</span>
<span class="t-add">+     return take();</span>
<span class="t-ctx">   {"}"}</span>

<span class="t-muted">3 lines changed | 1 file | review pending</span></pre>
    <p class="term-note">
      <span class="hl-red">→</span> sign off, or send findings back into the next
      plan.
    </p>
  </div>
</section>

---
import fs from "node:fs";
import DocsLayout from "../layouts/DocsLayout.astro";

// License text is plain text, not markdown — rendered literally.
const license = fs.readFileSync("../LICENSE", "utf8");
const thirdparty = fs.readFileSync("../misc/LICENSE.thirdparty.txt", "utf8");
---

<DocsLayout slug="license" title="License">
  <pre class="file-body">{license}</pre>
  <h2 class="file-heading">Third-Party Licenses</h2>
  <pre class="file-body">{thirdparty}</pre>
</DocsLayout>

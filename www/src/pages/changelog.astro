---
import fs from "node:fs";
import { renderMarkdown } from "../lib/markdown";
import DocsLayout from "../layouts/DocsLayout.astro";

const raw = fs.readFileSync("../CHANGELOG.txt", "utf8");
const changelog = await renderMarkdown(raw);
---

<DocsLayout slug="changelog" title="Changelog">
  <div class="wiki-doc" set:html={changelog} />
</DocsLayout>

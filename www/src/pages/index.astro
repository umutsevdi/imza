---
import BaseLayout from "../layouts/BaseLayout.astro";
import SidePanel from "../components/SidePanel.astro";
import Statusbar from "../components/Statusbar.astro";
import Hero from "../components/Hero.astro";
import ModeSwitcher from "../components/ModeSwitcher.astro";
import Highlights from "../components/Highlights.astro";
import Headless from "../components/Headless.astro";
import Performance from "../components/Performance.astro";
import GetStarted from "../components/GetStarted.astro";
---

<BaseLayout
  title="imza - Open Source Coding Agent"
  description="A terminal coding agent that keeps you in the loop: plan it together, build it together, review it together. Native, local, no telemetry."
>
  <div class="app">
    <div class="app-row">
      <SidePanel />
      <div class="maincol">
        <main id="main">
          <Hero />
          <ModeSwitcher />
          <Highlights />
          <Headless />
          <Performance />
          <GetStarted />
        </main>
      </div>
    </div>
    <Statusbar />
  </div>
</BaseLayout>
